auth.learn-map.in {
    tls admin@learn-map.in
    
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.learn-map.in https://auth.learn-map.in; frame-ancestors 'self'; frame-src 'self' https://auth.learn-map.in;"
    }
    
    # Health check endpoints
    handle /health/ready {
        reverse_proxy keycloak:9000
    }
    
    handle /health/live {
        reverse_proxy keycloak:9000
    }
    
    handle /metrics {
        reverse_proxy keycloak:9000
    }
    
    # Main application
    reverse_proxy keycloak:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}