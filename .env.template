# Keycloak Server Environment Variables
# Copy to .env and fill in all values
# NEVER commit this file to git

# ===========================================
# Keycloak Database
# ===========================================
KC_DB_PASSWORD=<64-char-random-string-from-openssl-rand-base64-32>
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=${KC_DB_PASSWORD}

# ===========================================
# Keycloak Admin
# ===========================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<64-char-random-string-from-openssl-rand-base64-32>

# ===========================================
# Keycloak Clients (generate with: openssl rand -base64 32)
# ===========================================
WEB_CLIENT_SECRET=<64-char-random-string>
API_CLIENT_SECRET=<64-char-random-string>
ADMIN_CLIENT_SECRET=<64-char-random-string>

# ===========================================
# SMTP (Resend) - for email verification, password reset
# ===========================================
KC_SMTP_SERVER=smtp.resend.com
KC_SMTP_PORT=587
KC_SMTP_USERNAME=resend
KC_SMTP_PASSWORD=<YOUR_RESEND_API_KEY>
KC_SMTP_FROM=noreply@learn-map.in
KC_SMTP_SSL=true

# ===========================================
# Hostname
# ===========================================
KC_HOSTNAME=auth.learn-map.in